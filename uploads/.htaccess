# Prevent execution of PHP in uploads directory
<FilesMatch "\.php$">
    Order allow,deny
    Deny from all
</FilesMatch>

# Allow direct access to uploaded images (fixes mobile 403s)
<FilesMatch "\.(jpg|jpeg|png|gif|webp|svg|ico|bmp|avif)$">
    Order allow,deny
    Allow from all
</FilesMatch>

# Ensure correct MIME types so mobile browsers actually render the images
AddType image/jpeg .jpg .jpeg
AddType image/png  .png
AddType image/gif  .gif
AddType image/webp .webp
AddType image/svg+xml .svg
AddType image/x-icon .ico
AddType image/avif .avif
